{
  "version": 1,
  "purpose": "agent_tool_registry",
  "tools": [
    {
      "name": "harness_common",
      "path": "Harness/scripts/tools/harness_common.py",
      "purpose": "다른 Harness 도구에서 공유하는 헬퍼 함수 모음",
      "inputs": ["없음 (import 전용)"],
      "outputs": ["없음 (라이브러리)"],
      "writes_files": false,
      "safe_by_default": true,
      "verify": "python -c \"import sys; sys.path.insert(0, 'Harness/scripts/tools'); from harness_common import find_project_root; print(find_project_root())\""
    },
    {
      "name": "harness_context",
      "path": "Harness/scripts/tools/harness_context.py",
      "purpose": "작업 시작 전 Harness 현황을 짧게 요약해 에이전트 컨텍스트 비용을 줄임",
      "inputs": ["--request (선택)", "--root (선택)"],
      "outputs": ["텍스트 또는 JSON 현황 요약"],
      "writes_files": false,
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_context.py --help"
    },
    {
      "name": "harness_diff_guard",
      "path": "Harness/scripts/tools/harness_diff_guard.py",
      "purpose": "변경 파일과 JavaScript 리스크 신호를 요약해 작업 전후 위험도 파악",
      "inputs": ["--root (선택)", "--json (선택)"],
      "outputs": ["변경 파일 목록, 리스크 분류"],
      "writes_files": false,
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_diff_guard.py --help"
    },
    {
      "name": "harness_cycle",
      "path": "Harness/scripts/tools/harness_cycle.py",
      "purpose": "사이클 로그 항목을 일관된 형식으로 생성",
      "inputs": ["task_name", "--changed (반복 가능)", "--verified (반복 가능)", "--remaining (반복 가능)", "--write (파일 쓰기 활성화)", "--date (선택)"],
      "outputs": ["사이클 로그 텍스트 또는 파일 추가"],
      "writes_files": true,
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_cycle.py --help"
    },
    {
      "name": "harness_state_check",
      "path": "Harness/scripts/tools/harness_state_check.py",
      "purpose": "state/next/cycles 파일이 너무 크거나 오래됐는지 확인",
      "inputs": ["--target (선택)", "--json (선택)"],
      "outputs": ["파일별 크기·신선도 체크 결과"],
      "writes_files": false,
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_state_check.py --help"
    },
    {
      "name": "harness_handoff",
      "path": "Harness/scripts/tools/harness_handoff.py",
      "purpose": "작업자 전환 시 새 작업자가 먼저 읽을 최소 브리핑 생성",
      "inputs": ["--request (선택)", "--write (파일 쓰기 활성화)", "--root (선택)"],
      "outputs": ["브리핑 텍스트 또는 파일"],
      "writes_files": true,
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_handoff.py --help"
    }
  ]
}
