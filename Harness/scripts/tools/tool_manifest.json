{
  "version": 1,
  "purpose": "agent_tool_registry",
  "tools": [
    {
      "name": "harness_common",
      "path": "Harness/scripts/tools/harness_common.py",
      "purpose": "Shared helper functions imported by other Harness tools.",
      "inputs": ["none; import-only helper"],
      "outputs": ["none; library module"],
      "writes_files": false,
      "safe_by_default": true,
      "verify": "python -c \"import sys; sys.path.insert(0, 'Harness/scripts/tools'); from harness_common import find_project_root; print(find_project_root())\""
    },
    {
      "name": "harness_context",
      "path": "Harness/scripts/tools/harness_context.py",
      "purpose": "Print a compact Harness briefing before an agent starts work.",
      "inputs": ["--request optional", "--root optional", "--json optional"],
      "outputs": ["text or JSON context summary"],
      "writes_files": false,
      "safe_by_default": true,
      "context_check": true,
      "verify": "python Harness/scripts/tools/harness_context.py --help"
    },
    {
      "name": "harness_docs_check",
      "path": "Harness/scripts/tools/harness_docs_check.py",
      "purpose": "Check project-doc roots and evaluate the on-demand reading policy.",
      "inputs": ["--request optional", "--root optional", "--json optional"],
      "outputs": ["docs policy report"],
      "writes_files": false,
      "safe_by_default": true,
      "context_check": true,
      "verify": "python Harness/scripts/tools/harness_docs_check.py --help"
    },
    {
      "name": "harness_doctor",
      "path": "Harness/scripts/tools/harness_doctor.py",
      "purpose": "Validate Harness structure, config files, and tool manifest consistency.",
      "inputs": ["--root optional", "--json optional"],
      "outputs": ["structure and policy consistency report"],
      "writes_files": false,
      "safe_by_default": true,
      "context_check": true,
      "verify": "python Harness/scripts/tools/harness_doctor.py --help"
    },
    {
      "name": "harness_diff_guard",
      "path": "Harness/scripts/tools/harness_diff_guard.py",
      "purpose": "Summarize changed files and JavaScript risk signals before finishing work.",
      "inputs": ["--root optional", "--json optional"],
      "outputs": ["changed files and risk classifications"],
      "writes_files": false,
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_diff_guard.py --help"
    },
    {
      "name": "harness_cycle",
      "path": "Harness/scripts/tools/harness_cycle.py",
      "purpose": "Create short cycle log entries in a consistent format.",
      "inputs": ["title", "--changed repeatable", "--verified repeatable", "--remaining repeatable", "--write optional", "--date optional"],
      "outputs": ["cycle entry text or appended cycle file"],
      "writes_files": true,
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_cycle.py --help"
    },
    {
      "name": "harness_state_check",
      "path": "Harness/scripts/tools/harness_state_check.py",
      "purpose": "Check that state, next, and cycle files stay compact and current.",
      "inputs": ["--target optional", "--json optional"],
      "outputs": ["state/next/cycles size and stale-path report"],
      "writes_files": false,
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_state_check.py --help"
    },
    {
      "name": "harness_handoff",
      "path": "Harness/scripts/tools/harness_handoff.py",
      "purpose": "Create a compact handoff brief for another primary worker.",
      "inputs": ["--request optional", "--output optional", "--write optional", "--json optional"],
      "outputs": ["handoff brief text or file"],
      "writes_files": true,
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_handoff.py --help"
    },
    {
      "name": "harness_verify_all",
      "path": "Harness/scripts/tools/harness_verify_all.py",
      "purpose": "Run the standard lightweight Harness verification bundle.",
      "inputs": ["--root optional", "--skip-compile optional", "--json optional"],
      "outputs": ["combined verification report"],
      "writes_files": false,
      "safe_by_default": true,
      "verify": "python Harness/scripts/tools/harness_verify_all.py --help"
    }
  ]
}
